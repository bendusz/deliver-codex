+test('installed complete operation routes the native remote lifecycle without advertising low-level commands as operations', async () => {
+  const skill = await installedSkill();
+  const map = JSON.parse(read(skill, 'assets/operations.json'));
+  const complete = map.operations.filter((operation) => operation.name === 'complete');
+  assert.equal(complete.length, 1);
+  assert.equal(complete[0].reference, 'references/shipping.md');
+  assert.equal(complete[0].mutation.mode, 'delivery-write');
+  assert(complete[0].mutation.external.includes('verified-merge'));
+  assert.match(complete[0].mutation.external.join('\n'), /push/i);
+  assert.match(complete[0].mutation.external.join('\n'), /pull.?request/i);
+  assert.equal(map.operations.some((operation) => operation.name.startsWith('remote-')), false,
+    'low-level PM commands must remain implementation details of complete');
+
+  const shipping = read(skill, 'references/shipping.md');
+  for (const command of [
+    'remote-source-publish',
+    'remote-source-readiness',
+    'remote-source-merge',
+    'remote-source-reconcile',
+    'remote-evidence-prepare',
+    'remote-evidence-finalize',
+    'remote-closure-checkout-prepare',
+    'remote-closure-checkout-adopt',
+    'remote-report-prepare',
+    'remote-close-prepare',
+    'remote-handoff-prepare',
+    'remote-closure-publish',
+    'remote-closure-reconcile',
+    'remote-handoff-repair-prepare',
+    'remote-handoff-repair-adopt',
+    'remote-handoff-repair-publish',
+    'remote-handoff-repair-reconcile',
+    'remote-completion-prepare',
+    'remote-completion-adopt',
+  ]) assert.match(shipping, new RegExp(`\\b${command}\\b`), `${command} is missing from native shipping guidance`);
+  assert.match(shipping, /merge commit|merge method|MERGE_METHOD_UNSUPPORTED/i);
+  assert.match(shipping, /LOCAL_ADOPTION_PENDING|local adoption pending/i);
+  assert.match(shipping, /standing authority/i);
+  assert.doesNotMatch(shipping, /--admin|--auto|--force|--delete-branch/);
+});
