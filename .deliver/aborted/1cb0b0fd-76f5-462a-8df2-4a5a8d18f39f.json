      "id": "T02",
      "objective": "Implement strict story readers and read-only upstream-compatible project inspector",
      "acceptance": [
        {
          "id": "T02-AC1",
          "text": "Valid current upstream projects produce matching derived phase, approval, claims, sprint, worktree and handoff state against unchanged pinned inspector."
        },
        {
          "id": "T02-AC2",
          "text": "Strict story parsing preserves exact ordered criterion text and substantive contract hash while precisely separating Execution metadata; unsafe or duplicate sections fail."
        },
        {
          "id": "T02-AC3",
          "text": "Inspection handles malformed/missing/FIFO/symlink inputs and missing identity without mutation, hangs or false completion, and pm status exposes it without breaking legacy reads."
        }
